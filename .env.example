# dji-sd-sync settings. Copy this file to .env and edit the values BEFORE running install.sh:
#   cp .env.example .env
# Plain KEY=value lines (POSIX sh syntax, no spaces around "=").
# Spaces, quotes and the characters | & \ are not allowed in values.

# --- REQUIRED -----------------------------------------------------------------
# User the import runs as (owner of the copied files). Must not be root.
DJI_USER=your_username
# Destination folder for the copied footage, absolute path.
DJI_DEST=/home/your_username/storage/dji

# --- OPTIONAL -----------------------------------------------------------------
# React only to the card with this UUID (find it with: blkid /dev/sdX1).
# Leave empty to react to any vfat/exfat card.
DJI_UUID=

# --- ADVANCED (the defaults are fine for most setups) ---------------------------
# DCIM folder on the mounted card, used by manual runs of dji_import.sh
# (the service mounts each card itself and passes its own path).
DJI_SOURCE=/mnt/sd/DCIM
# Run time limit of one import (systemd time span).
DJI_TIMEOUT=2h
# Mount point prefix; the device name is appended, e.g. /mnt/sd-sdb1.
DJI_MOUNT_PREFIX=/mnt/sd-
# Install locations.
DJI_LIBDIR=/usr/local/lib/dji-import
DJI_UNIT=/etc/systemd/system/dji-import@.service
DJI_RULES=/etc/udev/rules.d/99-dji-sd.rules
